{
  "$comment": "Pages the site QA visits (scripts/site-qa.mjs). One entry per template. A string is a fixed path. A 'discover' entry opens that page and takes the first 'take' internal links whose path matches 'match' (a regex), so the newest brief or auction is always the one checked; 'each' repeats the discovery on every page found. 'status' is the HTTP status the page must answer with (default 200). See docs/qa.md.",
  "pages": [
    "/",
    "/pricing",
    "/licensing",
    "/buying",
    "/trust",
    "/about",
    "/editorial-standards",
    "/data/frontier-local-debt",
    "/data/frontier-local-debt/monitor",
    "/markets",
    "/markets/tbills",
    { "discover": "/markets/tbills", "match": "^/markets/tbills/[a-z-]+$", "take": 3, "label": "T-bill market pages" },
    "/markets/bonds",
    { "discover": "/markets/bonds", "match": "^/markets/bonds/[a-z-]+$", "take": 1, "label": "Bond market page" },
    {
      "discover": "/markets/bonds",
      "match": "^/markets/bonds/[a-z-]+$",
      "take": 20,
      "label": "Bond market pages",
      "visit": false,
      "each": { "match": "^(?:{parent}|/markets/kenya-bonds)/(?:[a-z0-9-]+/)?\\d{4}-\\d{2}-\\d{2}$", "take": 1, "label": "Dated bond auction, one per market" }
    },
    "/markets/kenya-tbills",
    "/markets/kenya-bonds",
    "/east-africa",
    "/rates/kenya",
    "/rates/kenya/money-market-funds",
    "/rates/kenya/loan-apps",
    "/brief",
    { "discover": "/brief", "match": "^/brief/[a-z0-9-]+$", "take": 3, "label": "Newest briefs" },
    "/weekly",
    "/morning",
    "/developers",
    "/data-api",
    "/downloads",
    "/status",
    "/corrections",
    "/numbers",
    "/compare",
    "/stories",
    "/countries/kenya",
    "/thank-you",
    "/data/inflation",
    "/learn",
    { "path": "/qa-this-page-does-not-exist", "status": 404, "label": "404 page" }
  ]
}
