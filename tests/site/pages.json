{
  "$comment": "Pages the site QA visits (scripts/site-qa.mjs). One entry per template. A string is a fixed path. A 'discover' entry opens that page and takes the first 'take' internal links whose path matches 'match' (a regex), so the newest brief or auction is always the one checked; 'each' repeats the discovery on every page found. 'status' is the HTTP status the page must answer with (default 200). See docs/qa.md.",
  "pages": [
    "/",
    "/receipts",
    { "discover": "/receipts", "match": "^/receipts/\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$", "take": 1, "label": "Receipt page" },
    "/for-institutions",
    "/pricing",
    "/licensing",
    "/buying",
    "/trust",
    "/about",
    "/editorial-standards",
    "/data/frontier-local-debt",
    "/data/frontier-local-debt/monitor",
    "/markets",
    "/markets/tbills",
    { "discover": "/markets/tbills", "match": "^/markets/tbills/[a-z-]+$", "take": 3, "label": "T-bill market pages" },
    "/markets/bonds",
    { "discover": "/markets/bonds", "match": "^/markets/bonds/[a-z-]+$", "take": 1, "label": "Bond market page" },
    {
      "discover": "/markets/bonds",
      "match": "^/markets/bonds/[a-z-]+$",
      "take": 20,
      "label": "Bond market pages",
      "visit": false,
      "each": { "match": "^(?:{parent}|/markets/kenya-bonds)/(?:[a-z0-9-]+/)?\\d{4}-\\d{2}-\\d{2}$", "take": 1, "label": "Dated bond auction, one per market" }
    },
    "/markets/kenya-tbills",
    "/markets/kenya-bonds",
    "/east-africa",
    "/rates/kenya",
    "/rates/kenya/money-market-funds",
    "/rates/kenya/loan-apps",
    "/markets/kenya-tbills/call-it",
    "/rates/kenya/debt-plan",
    "/diaspora",
    "/brief",
    { "discover": "/brief", "match": "^/brief/[a-z0-9-]+$", "take": 3, "label": "Newest briefs" },
    "/weekly",
    "/morning",
    "/developers",
    "/data-api",
    "/downloads",
    "/status",
    "/corrections",
    "/numbers",
    "/rates/compare?a=kenya-91d&b=kenya-cbr",
    "/rates/compare?a=kenya-91d&b=kenya-mmf",
    "/rates/compare?a=kenya-364d&b=kenya-bank-deposit",
    "/rates/compare?a=kenya-91d&b=kenya-364d",
    "/rates/compare?a=kenya-364d&b=nigeria-364d",
    "/rates/compare?a=kenya-bank-lending&b=kenya-cpi",
    "/rates/series/kenya-91d",
    "/rates/series/kenya-cbr",
    "/rates/policy",
    "/compare",
    "/stories",
    "/tools",
    "/sw",
    "/casebook",
    "/registry",
    "/record",
    { "discover": "/registry", "match": "^/registry/[a-z0-9-]+$", "take": 2 },
    "/compare?peer=bank",
    "/registry/mwalimu-national-sacco",
    "/registry/kcb-bank-kenya",
    "/registry/kenya-women-microfinance-bank",
    { "discover": "/casebook", "match": "^/casebook/AF-[A-Z]{2}-\\d{4}-\\d{2}$", "take": 3 },
    "/countries/kenya",
    "/thank-you",
    "/data/inflation",
    "/learn",
    { "path": "/qa-this-page-does-not-exist", "status": 404, "label": "404 page" }
  ]
}
